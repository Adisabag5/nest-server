# development | test | production. Required: CORS and the refresh cookie's
# secure/SameSite flags key off it, so an unset value downgrades both silently.
NODE_ENV=development

# Copy to .env and fill in real values. .env is gitignored; this file is the schema.

PORT=3000

# DB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=nest_server

# Auth
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random
JWT_EXPIRES_IN=15m

# Refresh tokens (separate secret: a leaked access secret must not mint refresh tokens)
JWT_REFRESH_SECRET=another-32-plus-character-random-string
JWT_REFRESH_EXPIRES_IN=7d
# comma-separated origins allowed to send the refresh cookie
CORS_ORIGIN=http://localhost:4200

# Absolute path to the built Angular app (visual-sequencer/dist/<project>/browser).
# Set in production to serve the frontend and the API from one origin; leave it
# unset for API-only, which is what dev and the tests expect.
# CLIENT_DIST=/var/www/pulse/client

# Number of reverse proxies in front of the app: 1 behind the nginx in
# DEPLOY.md, unset when Node is exposed directly. It decides what req.ip is and
# therefore what rate limiting counts — wrong either way fails silently.
# TRUST_PROXY=1
